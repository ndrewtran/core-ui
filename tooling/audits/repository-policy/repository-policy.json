{
  "schemaVersion": 1,
  "requiredRootCommands": [
    "check",
    "check:all",
    "generate",
    "generate:check",
    "test:agent",
    "release:prepare"
  ],
  "majorOwners": [
    { "path": "strategy", "classification": "authority" },
    { "path": "decisions", "classification": "canonical" },
    { "path": "catalog", "classification": "canonical" },
    { "path": "packages", "classification": "source" },
    { "path": "apps", "classification": "projection-source" },
    { "path": "tooling", "classification": "source" },
    { "path": "tests", "classification": "proof" }
  ],
  "projectionPathSegments": [
    "build",
    "coverage",
    "dist",
    "generated"
  ],
  "retainedProjectionFixtureRoots": [
    "tests/fixtures"
  ],
  "slugPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
  "generatedMarkers": {
    "source": "@generated-from:",
    "digest": "@generated-content-sha256:"
  },
  "strictJsonProjections": [
    {
      "path": "packages/catalog/generated/catalog.json",
      "provenance": "packages/catalog/generated/catalog.json.provenance"
    },
    {
      "path": "packages/catalog/generated/catalog-package.json",
      "provenance": "packages/catalog/generated/catalog-package.json.provenance"
    },
    {
      "path": "packages/react/generated/descriptor.json",
      "provenance": "packages/react/generated/descriptor.json.provenance"
    },
    {
      "path": "packages/react/generated/button-donor-comparison.json",
      "provenance": "packages/react/generated/button-donor-comparison.json.provenance"
    },
    {
      "path": "packages/react/generated/release.json",
      "provenance": "packages/react/generated/release.json.provenance"
    },
    {
      "path": "packages/tokens/generated/tale-token-occurrences.json",
      "provenance": "packages/tokens/generated/tale-token-occurrences.json.provenance"
    }
  ],
  "generatorProjectionGroups": [
    {
      "id": "core-ui-catalog-generation-v1",
      "whenCanonicalSourcePrefixes": ["catalog/"],
      "whenProjectionsInclude": [
        "packages/catalog/generated/catalog.json",
        "packages/catalog/generated/catalog-package.json"
      ],
      "outputs": [
        "packages/catalog/generated/catalog-package.json",
        "packages/catalog/generated/catalog-package.json.provenance",
        "packages/catalog/generated/catalog.json",
        "packages/catalog/generated/catalog.json.provenance",
        "packages/catalog/generated/catalog.mjs"
      ]
    }
  ],
  "globalTaskInputs": [
    ".agents/",
    ".github/",
    "catalog/",
    "decisions/",
    "packages/",
    "strategy/",
    "apps/",
    "tooling/",
    "tests/",
    ".node-version",
    ".npmrc",
    "AGENTS.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "dependencyPreparation": {
    "argvTemplate": [
      "pnpm",
      "install",
      "--offline",
      "--frozen-lockfile",
      "--ignore-scripts",
      "--store-dir",
      "<declared-offline-store>"
    ],
    "environmentKeys": [
      "CI",
      "HOME",
      "LANG",
      "LC_ALL",
      "PATH",
      "TMPDIR"
    ],
    "profile": "core-ui-dependency-preparation-command-v1",
    "storePlaceholder": "<declared-offline-store>"
  },
  "r1ContinuousExecution": {
    "failClosed": true,
    "profile": "core-ui-r1-continuous-execution-verifier-v1",
    "verifierPath": "tooling/audits/repository-policy/src/r1-continuous-execution-verify.mjs",
    "testPath": "tooling/audits/repository-policy/test/r1-continuous-execution.test.mjs",
    "manifestPath": "decisions/0010-amendment-04-r1-continuous-execution-materialization.json",
    "authorityMerge": {
      "commit": "65855ac805fe0f74798099d0d1ef47e860ba24a6",
      "tree": "a84b77f804b79fa4a9fe8f630d98e63986e92ca7"
    },
    "bootstrapWriteSet": [
      "packages/schema/schemas/change-intent-envelope.schema.json",
      "packages/schema/test/change-intent-envelope.test.mjs",
      "packages/tooling/src/change-intent.mjs",
      "packages/tooling/test/change-intent.test.mjs",
      "tooling/audits/repository-policy/repository-policy.json",
      "tooling/audits/repository-policy/src/cli.mjs",
      "tooling/audits/repository-policy/src/r1-continuous-execution-verify.mjs",
      "tooling/audits/repository-policy/test/r1-continuous-execution.test.mjs"
    ],
    "policyGate": {
      "requiredEnv": "CORE_UI_R1_OPERATION_REQUIRED",
      "descriptorEnv": "CORE_UI_R1_OPERATION_PATH",
      "recordRoot": ".git/core-ui-r1/",
      "noOpPrefixes": ["notes/"]
    },
    "hosted": {
      "provider": "github",
      "repository": "ndrewtran/core-ui",
      "defaultBranch": "main",
      "protectedRef": "refs/heads/main"
    }
  },
  "toolchain": {
    "node": "24.19.0",
    "nodeRange": ">=24.19.0 <25",
    "pnpm": "10.33.0"
  }
}
