{
  "schemaVersion": "2.1.0",
  "id": "core:token:button-minimum",
  "kind": "token",
  "name": "Core UI default theme tokens",
  "summary": "The brand-agnostic default theme and minimum fixed-slice token contract.",
  "lifecycle": "experimental",
  "tokenContractVersion": "1.1.0",
  "theme": {
    "name": "default",
    "modeAxes": {
      "colorScheme": ["light", "dark"],
      "contrast": ["standard", "more"],
      "motion": ["full", "reduced"],
      "density": ["comfortable", "compact"],
      "direction": ["ltr", "rtl"]
    },
    "defaultModes": {
      "colorScheme": "light",
      "contrast": "standard",
      "motion": "full",
      "density": "comfortable",
      "direction": "ltr"
    },
    "runtimeSwitching": "unavailable"
  },
  "tokens": {
    "reference.color.action-dark": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default dark action surface value.",
      "overridePolicy": "fixed",
      "value": "#1f2937"
    },
    "reference.color.action-light": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default light action surface value.",
      "overridePolicy": "fixed",
      "value": "#f9fafb"
    },
    "reference.color.focus": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default visible focus indicator value.",
      "overridePolicy": "fixed",
      "value": "#2563eb"
    },
    "reference.color.invalid": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default invalid-state value.",
      "overridePolicy": "fixed",
      "value": "#b91c1c"
    },
    "reference.color.surface": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default neutral surface value.",
      "overridePolicy": "fixed",
      "value": "#ffffff"
    },
    "reference.color.text-dark": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default dark text value.",
      "overridePolicy": "fixed",
      "value": "#111827"
    },
    "reference.color.text-light": {
      "layer": "reference",
      "type": "color",
      "unit": "hex",
      "meaning": "Default light text value.",
      "overridePolicy": "fixed",
      "value": "#ffffff"
    },
    "reference.dimension.control-height": {
      "layer": "reference",
      "type": "dimension",
      "unit": "px",
      "meaning": "Default control minimum height.",
      "overridePolicy": "fixed",
      "value": 40
    },
    "reference.dimension.radius-medium": {
      "layer": "reference",
      "type": "dimension",
      "unit": "px",
      "meaning": "Default medium corner radius.",
      "overridePolicy": "fixed",
      "value": 6
    },
    "reference.dimension.space-inline": {
      "layer": "reference",
      "type": "dimension",
      "unit": "px",
      "meaning": "Default inline control spacing.",
      "overridePolicy": "fixed",
      "value": 12,
      "modes": {
        "density.compact": { "value": 8 }
      }
    },
    "reference.duration.fast": {
      "layer": "reference",
      "type": "duration",
      "unit": "ms",
      "meaning": "Default short feedback duration.",
      "overridePolicy": "fixed",
      "value": 120,
      "modes": {
        "motion.reduced": { "value": 0 }
      }
    },
    "semantic.action.background": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Background for an immediate action.",
      "overridePolicy": "theme",
      "alias": "reference.color.action-dark",
      "modes": {
        "colorScheme.dark": { "alias": "reference.color.action-light" }
      }
    },
    "semantic.action.foreground": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Foreground content on an immediate action.",
      "overridePolicy": "theme",
      "alias": "reference.color.text-light",
      "modes": {
        "colorScheme.dark": { "alias": "reference.color.text-dark" }
      }
    },
    "semantic.control.min-height": {
      "layer": "semantic",
      "type": "dimension",
      "unit": "px",
      "meaning": "Minimum interactive control height.",
      "overridePolicy": "theme",
      "alias": "reference.dimension.control-height"
    },
    "semantic.control.padding-inline": {
      "layer": "semantic",
      "type": "dimension",
      "unit": "px",
      "meaning": "Inline spacing inside controls.",
      "overridePolicy": "theme",
      "alias": "reference.dimension.space-inline"
    },
    "semantic.control.radius": {
      "layer": "semantic",
      "type": "dimension",
      "unit": "px",
      "meaning": "Corner radius for controls.",
      "overridePolicy": "theme",
      "alias": "reference.dimension.radius-medium"
    },
    "semantic.field.background": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Background for editable fields and selections.",
      "overridePolicy": "theme",
      "alias": "reference.color.surface"
    },
    "semantic.feedback.invalid": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Indicator for invalid input and form state.",
      "overridePolicy": "fixed",
      "alias": "reference.color.invalid"
    },
    "semantic.focus.ring": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Visible focus indicator.",
      "overridePolicy": "fixed",
      "alias": "reference.color.focus"
    },
    "semantic.motion.feedback": {
      "layer": "semantic",
      "type": "duration",
      "unit": "ms",
      "meaning": "Optional short visual feedback duration.",
      "overridePolicy": "theme",
      "alias": "reference.duration.fast"
    },
    "semantic.overlay.background": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Background surface for dialog overlays.",
      "overridePolicy": "theme",
      "alias": "reference.color.surface"
    },
    "semantic.selection.track": {
      "layer": "semantic",
      "type": "color",
      "unit": "hex",
      "meaning": "Track for boolean selection controls.",
      "overridePolicy": "theme",
      "alias": "reference.color.action-dark"
    },
    "component.button.background": {
      "layer": "component",
      "type": "color",
      "unit": "hex",
      "meaning": "Public Button background customization point.",
      "overridePolicy": "instance",
      "alias": "semantic.action.background"
    },
    "component.button.foreground": {
      "layer": "component",
      "type": "color",
      "unit": "hex",
      "meaning": "Public Button foreground customization point.",
      "overridePolicy": "instance",
      "alias": "semantic.action.foreground"
    },
    "component.button.min-height": {
      "layer": "component",
      "type": "dimension",
      "unit": "px",
      "meaning": "Public Button minimum-height customization point.",
      "overridePolicy": "theme",
      "alias": "semantic.control.min-height"
    },
    "component.button.padding-inline": {
      "layer": "component",
      "type": "dimension",
      "unit": "px",
      "meaning": "Public Button inline-padding customization point.",
      "overridePolicy": "theme",
      "alias": "semantic.control.padding-inline"
    },
    "component.button.radius": {
      "layer": "component",
      "type": "dimension",
      "unit": "px",
      "meaning": "Public Button corner-radius customization point.",
      "overridePolicy": "theme",
      "alias": "semantic.control.radius"
    }
  }
}
