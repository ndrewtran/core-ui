{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ui.dev/schema/binding.schema.json",
  "title": "Core UI platform binding",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{
    "oneOf": [
      {
      "required": ["schemaVersion", "lifecycle", "strategy", "api", "behavior", "accessibility", "tokenSources", "runtimeProfiles"],
      "properties": { "strategy": {
        "enum": ["direct", "adapted", "native-alternative"],
        "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
      } },
      "not": {
        "anyOf": [
          { "required": ["reason"] },
          { "required": ["alternative"] }
        ]
      }
      },
      {
      "required": ["schemaVersion", "strategy", "reason"],
      "properties": { "strategy": {
        "const": "unsupported",
        "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
      } },
      "not": {
        "anyOf": [
          { "required": ["lifecycle"] },
          { "required": ["api"] },
          { "required": ["behavior"] },
          { "required": ["accessibility"] },
          { "required": ["tokenSources"] },
          { "required": ["runtimeProfiles"] }
        ]
      }
      }
    ]
  }],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "lifecycle": {
      "enum": ["experimental", "stable", "deprecated", "removed"],
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "strategy": {
      "enum": ["direct", "adapted", "native-alternative", "unsupported"],
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "alternative": {
      "$ref": "artifact-ref.schema.json",
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content"] }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "events", "parts", "defaults"],
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] },
      "properties": {
        "props": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "parts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true,
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "behavior": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "x-core-ui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      }
    },
    "accessibility": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
    },
    "tokenSources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^core:token:[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "x-core-ui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      }
    },
    "runtimeProfiles": {
      "type": "object",
      "additionalProperties": false,
      "x-core-ui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content", "binding-spec"]
      },
      "properties": {
        "ios": {
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.ios",
              "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        },
        "android": {
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.android",
              "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        },
        "native.react-native-web": {
          "x-core-ui-authoring": {
            "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
            "revisionAxes": ["binding-content", "binding-spec"]
          },
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": {
              "const": "native.react-native-web",
              "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } } }
          ]
        }
      }
    },
    "editorialNotes": {
      "type": "array",
      "items": { "type": "string" },
      "x-core-ui-authoring": { "effect": "editorial", "revisionAxes": ["binding-content"], "autofixes": ["trim-outer-whitespace"] }
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "x-core-ui-authoring": {
        "effects": { "add": "compatible", "remove": "incompatible", "replace": "incompatible" },
        "revisionAxes": ["binding-content"]
      }
    }
  },
  "$defs": {
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "oneOf": [
          {
            "required": ["strategy", "lifecycle", "validationProfile"],
            "properties": { "strategy": {
              "enum": ["direct", "adapted", "native-alternative"],
              "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } },
            "not": {
              "anyOf": [
                { "required": ["reason"] },
                { "required": ["alternative"] }
              ]
            }
          },
          {
            "required": ["strategy", "reason"],
            "properties": { "strategy": {
              "const": "unsupported",
              "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
            } },
            "not": {
              "anyOf": [
                { "required": ["lifecycle"] },
                { "required": ["validationProfile"] }
              ]
            }
          }
        ]
      }],
      "properties": {
        "strategy": {
          "enum": ["direct", "adapted", "native-alternative", "unsupported"],
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "lifecycle": {
          "enum": ["experimental", "stable", "deprecated", "removed"],
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "validationProfile": {
          "enum": ["native.ios", "native.android", "native.react-native-web"],
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        },
        "alternative": {
          "$ref": "artifact-ref.schema.json",
          "x-core-ui-authoring": { "effect": "incompatible", "revisionAxes": ["binding-content", "binding-spec"] }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^core\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": true
    }
  }
}
