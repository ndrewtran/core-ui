{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ui.dev/schema/binding.schema.json",
  "title": "Core UI platform binding",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{
    "oneOf": [
      {
      "required": ["schemaVersion", "lifecycle", "strategy", "api", "behavior", "accessibility", "tokenSources", "runtimeProfiles"],
      "properties": { "strategy": { "enum": ["direct", "adapted", "native-alternative"] } }
      },
      {
      "required": ["schemaVersion", "strategy"],
      "properties": { "strategy": { "const": "unsupported" } },
      "anyOf": [{ "required": ["reason"] }, { "required": ["alternative"] }],
      "not": {
        "anyOf": [
          { "required": ["lifecycle"] },
          { "required": ["api"] },
          { "required": ["behavior"] },
          { "required": ["accessibility"] },
          { "required": ["tokenSources"] },
          { "required": ["runtimeProfiles"] }
        ]
      }
      }
    ]
  }],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
    "strategy": { "enum": ["direct", "adapted", "native-alternative", "unsupported"] },
    "reason": { "type": "string", "minLength": 1 },
    "alternative": { "$ref": "artifact-ref.schema.json" },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["props", "events", "parts", "defaults"],
      "properties": {
        "props": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "events": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "parts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "defaults": { "type": "object", "additionalProperties": true }
      }
    },
    "behavior": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "accessibility": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tokenSources": { "type": "array", "items": { "type": "string", "pattern": "^core:token:[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
    "runtimeProfiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ios": {
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": { "const": "native.ios" } } }
          ]
        },
        "android": {
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": { "const": "native.android" } } }
          ]
        },
        "native.react-native-web": {
          "allOf": [
            { "$ref": "#/$defs/runtimeProfile" },
            { "type": "object", "properties": { "validationProfile": { "const": "native.react-native-web" } } }
          ]
        }
      }
    },
    "editorialNotes": { "type": "array", "items": { "type": "string" } },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "runtimeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["direct", "adapted", "native-alternative", "unsupported"] },
        "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
        "validationProfile": { "enum": ["native.ios", "native.android", "native.react-native-web"] },
        "reason": { "type": "string", "minLength": 1 },
        "alternative": { "$ref": "artifact-ref.schema.json" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^core\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": true
    }
  }
}
