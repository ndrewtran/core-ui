{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ui.dev/schema/token-source.schema.json",
  "title": "Core UI minimum token source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "summary", "lifecycle", "tokenContractVersion", "tokens"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^core:token:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "const": "token" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
    "tokenContractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["color", "dimension", "duration", "number", "string"] },
          "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
          "alias": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$" }
        }
      }
    },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^core\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }, "additionalProperties": true }
  }
}
