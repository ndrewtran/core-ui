{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-ui.dev/schema/component.schema.json",
  "title": "Core UI component concept",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "summary", "lifecycle", "intent", "anatomy", "states", "accessibility", "bindings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^core:component:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "kind": { "const": "component" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated", "removed"] },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useWhen", "avoidWhen"],
      "properties": {
        "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "avoidWhen": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "anatomy": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" }, "uniqueItems": true },
    "states": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$" }, "uniqueItems": true },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nameRequired", "obligations"],
      "properties": {
        "nameRequired": { "type": "boolean" },
        "obligations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "web.html": { "$ref": "binding.schema.json" },
        "web.react": { "$ref": "binding.schema.json" },
        "native.react-native": { "$ref": "binding.schema.json" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^core\\.experimental\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": true
    }
  }
}
