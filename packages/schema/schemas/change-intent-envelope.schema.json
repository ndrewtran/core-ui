{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core-ui-change-intent-envelope-v1",
  "title": "Private Core UI ChangeIntentEnvelope v1",
  "description": "Closed, read-only R1 change intent grammar. Meaning and affected closure are derived by @core-ui/tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "schemaVersion",
    "intentId",
    "authority",
    "objective",
    "operation",
    "source",
    "proposal",
    "owners",
    "writeSet",
    "affected",
    "effects",
    "checks",
    "review",
    "readiness",
    "invalidation",
    "confirmation"
  ],
  "properties": {
    "profile": { "const": "core-ui-change-intent-envelope-v1" },
    "schemaVersion": { "const": "1.0.0" },
    "intentId": { "$ref": "#/$defs/digest" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "acceptance", "architecture", "roadmap", "productScope", "snapshot", "snapshotEnvelope", "baseline", "scope", "lock"],
      "properties": {
        "decision": { "$ref": "#/$defs/ownerIdentity" },
        "acceptance": { "$ref": "#/$defs/ownerIdentity" },
        "architecture": { "$ref": "#/$defs/ownerIdentity" },
        "roadmap": { "$ref": "#/$defs/ownerIdentity" },
        "productScope": { "$ref": "#/$defs/ownerIdentity" },
        "snapshot": { "$ref": "#/$defs/ownerIdentity" },
        "snapshotEnvelope": { "$ref": "#/$defs/ownerIdentity" },
        "baseline": { "$ref": "#/$defs/ownerIdentity" },
        "scope": { "$ref": "#/$defs/ownerIdentity" },
        "lock": { "$ref": "#/$defs/ownerIdentity" }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "target"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "target": { "$ref": "#/$defs/target" },
        "graph": { "$ref": "#/$defs/identity" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "effectClass"],
      "properties": {
        "kind": { "type": "string" },
        "effectClass": { "type": "string" },
        "action": { "enum": ["branch", "commit", "push", "open-pr", "check", "merge", "postmerge", "cleanup"] },
        "lock": { "$ref": "#/$defs/identity" },
        "evidence": { "$ref": "#/$defs/identity" },
        "transition": { "$ref": "#/$defs/transition" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "r1-lock" }, "effectClass": { "const": "explanation-only" }, "action": { "enum": ["check"] } }
        },
        {
          "properties": { "kind": { "const": "component-implementation" }, "effectClass": { "const": "renderer-source-write" }, "action": { "enum": ["commit", "check"] } }
        },
        {
          "properties": { "kind": { "const": "retained-evidence-acceptance" }, "effectClass": { "const": "evidence-retention-write" }, "action": { "enum": ["commit", "check"] } }
        },
        {
          "properties": { "kind": { "const": "routine-git-operation" }, "effectClass": { "const": "explanation-only" }, "action": { "enum": ["branch", "commit", "push", "open-pr", "check", "merge", "postmerge", "cleanup"] } }
        },
        {
          "properties": { "kind": { "const": "project-migration" }, "effectClass": { "const": "project-write" }, "action": { "enum": ["commit", "check"] } }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "enum": ["branch", "commit", "push", "open-pr", "merge", "postmerge", "cleanup"] } }
          },
          "then": { "required": ["transition"] }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "cleanWorktree", "lockfile"],
      "properties": {
        "commit": { "$ref": "#/$defs/hex40" },
        "tree": { "$ref": "#/$defs/hex40" },
        "branch": { "type": "string", "pattern": "^codex/[A-Za-z0-9._/-]+$" },
        "cleanWorktree": { "const": true },
        "lockfile": { "$ref": "#/$defs/identity" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "afterImages", "beforeImages"],
      "properties": {
        "patch": { "$ref": "#/$defs/identity" },
        "afterImages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "beforeImages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "selector", "source"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "owner": { "type": "string", "minLength": 1 },
          "selector": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/identity" },
          "recordId": { "type": ["string", "null"] }
        }
      }
    },
    "writeSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "effect"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "owner": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["canonical-source-write", "renderer-source-write", "evidence-retention-write"] },
          "recordId": { "type": ["string", "null"] }
        }
      }
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalSources", "packages", "projections", "generatedProjections", "relations", "staleProof", "deferred", "sourceRevision", "artifacts", "requiredChecks"],
      "properties": {
        "canonicalSources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "packages": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packageRef" } },
        "projections": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "generatedProjections": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "relations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relation" } },
        "staleProof": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deferred": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/deferred" } },
        "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "requiredChecks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rollback", "recovery"],
      "properties": {
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "binding", "package"],
          "properties": {
            "content": { "enum": ["none", "patch", "minor", "major"] },
            "binding": { "enum": ["none", "patch", "minor", "major"] },
            "package": { "enum": ["none", "patch", "minor", "major"] }
          }
        },
        "rollback": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "recovery": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "owner"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval", "generation", "migration"],
      "properties": {
        "retrieval": { "enum": ["not-applicable", "unknown", "blocked", "proved"] },
        "generation": { "enum": ["not-applicable", "unknown", "blocked", "proved"] },
        "migration": { "enum": ["not-applicable", "unknown", "blocked", "proved"] }
      }
    },
    "invalidation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "when"],
        "properties": {
          "domain": { "enum": ["authority", "lock", "source", "worktree", "patch", "after-image", "dependency", "graph", "proof", "disclosure", "review", "base-drift"] },
          "when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "effects"],
      "properties": {
        "required": { "const": true },
        "effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeDigest", "head", "tree", "diff", "changedPaths", "operationJournal", "deterministicResults"],
      "properties": {
        "envelopeDigest": { "$ref": "#/$defs/digest" },
        "head": { "$ref": "#/$defs/identity" },
        "tree": { "$ref": "#/$defs/identity" },
        "diff": { "$ref": "#/$defs/identity" },
        "changedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "operationJournal": { "$ref": "#/$defs/identity" },
        "deterministicResults": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "byteLength"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "ownerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "selector", "digest", "sourceCommit", "sourceTree"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "selector": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "sourceCommit": { "$ref": "#/$defs/hex40" },
        "sourceTree": { "$ref": "#/$defs/hex40" }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "type"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "readiness", "earliestBoundary"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "readiness": { "type": "string", "minLength": 1 },
        "earliestBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preimage", "result"],
      "properties": {
        "preimage": { "$ref": "#/$defs/identity" },
        "result": { "$ref": "#/$defs/identity" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "scopeId", "tranche", "source"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "scopeId": { "type": "string", "pattern": "^SCOPE-[A-Z0-9-]+$" },
        "tranche": { "pattern": "^R1\\.[0-5]$", "type": "string" },
        "source": { "type": "string", "pattern": "^(?:\\.\\/|\\.\\./)?[A-Za-z0-9._/-]+$" }
      }
    }
  }
}
